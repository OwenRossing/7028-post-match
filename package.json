{
  "name": "pitview",
  "private": true,
  "version": "1.0.0",
  "description": "Fast, offline-capable viewer for FRC Driver Station .dslog/.dsevents files",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
